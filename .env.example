# Tài khoản quản trị. Chỉ đặt giá trị thật trong .env.local trên máy chủ.
ADMIN_USERNAME=ten-dang-nhap-quan-tri
ADMIN_PASSWORD=thay-bang-mat-khau-rieng-cua-ban

# Khi triển khai trên Vercel: PostgreSQL chạy trên Coolify, ảnh/tư liệu trong Vercel Blob riêng tư.
# Dùng Postgres URL (public) do Coolify cung cấp sau khi bật SSL và public TCP proxy.
# DATABASE_URL=postgresql://user:password@host:port/giapha_huynhtan?sslmode=verify-full
# CA của PostgreSQL do Coolify tạo; có thể dán PEM nhiều dòng hoặc dùng \n.
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# Blob riêng tư: Vercel có thể cấp BLOB_STORE_ID + VERCEL_OIDC_TOKEN tự động.
# Chỉ dùng token tĩnh nếu project chưa dùng OIDC.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Vercel Cron gọi GET /api/reminders/run lúc 08:00 Việt Nam mỗi ngày.
# Trên máy riêng vẫn có thể gọi POST bằng scripts/run-reminders.mjs.
CRON_SECRET=thay-bang-chuoi-bi-mat-ngau-nhien
# Địa chỉ ứng dụng mà lệnh cron gọi đến; dùng HTTPS khi chạy từ máy khác.
APP_URL=http://127.0.0.1:3000

# Chỉ điền sau khi có OA/ZBS, quyền gửi tin và mẫu nhắc giỗ được duyệt.
# ZALO_APP_ID=
# ZALO_APP_SECRET=
# ZALO_REFRESH_TOKEN=
# ZALO_TEMPLATE_ID=
# Tên biến phải khớp với các placeholder trong mẫu ZBS đã được duyệt.
# ZALO_TEMPLATE_DATA_MAP={"recipient":"ten_nguoi_nhan","event":"ten_ngay_gio","lunarDate":"ngay_am","solarDate":"ngay_duong","location":"dia_diem"}
