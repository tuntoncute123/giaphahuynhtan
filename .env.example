# Tài khoản quản trị. Chỉ đặt giá trị thật trong .env.local trên máy chủ.
ADMIN_USERNAME=ten-dang-nhap-quan-tri
ADMIN_PASSWORD=thay-bang-mat-khau-rieng-cua-ban

# Lịch tự động gọi POST /api/reminders/run lúc 08:00 Việt Nam mỗi ngày.
CRON_SECRET=thay-bang-chuoi-bi-mat-ngau-nhien
# Địa chỉ ứng dụng mà lệnh cron gọi đến; dùng HTTPS khi chạy từ máy khác.
APP_URL=http://127.0.0.1:3000

# Chỉ điền sau khi có OA/ZBS, quyền gửi tin và mẫu nhắc giỗ được duyệt.
# ZALO_APP_ID=
# ZALO_APP_SECRET=
# ZALO_REFRESH_TOKEN=
# ZALO_TEMPLATE_ID=
# Tên biến phải khớp với các placeholder trong mẫu ZBS đã được duyệt.
# ZALO_TEMPLATE_DATA_MAP={"recipient":"ten_nguoi_nhan","event":"ten_ngay_gio","lunarDate":"ngay_am","solarDate":"ngay_duong","location":"dia_diem"}
